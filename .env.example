# Build-time (Vite). Leave VITE_QUOTE_ENDPOINT empty: the quote form then prepares a WhatsApp message (current mode).
# Optional later: set it to a quote API (see docs/API.md).
VITE_QUOTE_ENDPOINT=
# Used by scripts/generate.mjs for canonical URLs, hreflang and the sitemap.
SITE_URL=https://hsprint.ma
# Set when the site is served from a sub-path (for example GitHub Pages: /vieva-web/).
BASE=/

# Reference API (server/index.mjs)
PORT=8787
ALLOW_ORIGIN=http://localhost:5173
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Optional: receives a JSON {"text": "..."} on every new quote (WhatsApp/Slack/email bridge)
WEBHOOK_URL=
